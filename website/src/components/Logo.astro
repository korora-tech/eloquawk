---
// The app icon from data/branding/eloquawk-app-icon.svg, copied to
// public/favicon.svg so the same file serves as the favicon.
interface Props {
  size?: number;
  class?: string;
}

const { size = 32, class: className } = Astro.props;
---

<img class={className} src="/favicon.svg" width={size} height={size} alt="" />
