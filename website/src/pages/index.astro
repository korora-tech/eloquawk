---
import { Code } from "astro:components";
import Base from "../layouts/Base.astro";
import CopyCommand from "../components/CopyCommand.astro";
import { SITE } from "../lib/site";

const themes = { light: "github-light", dark: "github-dark-default" } as const;
const testerAccess = "mailto:david@rawkode.academy?subject=Eloquawk%20tester%20access";
const ownClient = `${SITE.repo}/blob/main/docs/google-gmail.md#using-your-own-oauth-client`;

// The screenshots are copies of docs/screenshots, served from this site so the
// Content-Security-Policy can stay at img-src 'self'. All are 1693 by 996.
const shot = { width: 1693, height: 996 };
const gallery = [
  {
    src: "/screenshots/demo-newsletter-light.webp",
    alt: "Eloquawk in the light theme with The Weekly Byte newsletter open: the HTML mail converted to plain text, with every link shown in full.",
    caption: "An HTML newsletter, converted to text, in the light theme.",
  },
  {
    src: "/screenshots/demo-reply.webp",
    alt: "A reply window to Zoë Ångström with From, To and Subject fields, a choice of two sending accounts, the quoted original message, and Send and Attach buttons.",
    caption: "A reply, in its own window, from either account.",
  },
  {
    src: "/screenshots/demo-search.webp",
    alt: "Search results for from:zoë, listing thirteen conversations from one demo account beside the label sidebar.",
    caption: "Search with Gmail's own syntax.",
  },
  {
    src: "/screenshots/demo-shortcuts.webp",
    alt: "The keyboard shortcuts overlay, listing every key for mail, message text, the label picker, search, the compose window, Settings and anywhere in the app.",
    caption: "Press ? for every shortcut.",
  },
];

const features = [
  {
    glyph: "@",
    title: "Several Google accounts",
    body: "Each account's labels sit in the sidebar with their unread counts. Collapse the ones you are not using.",
  },
  {
    glyph: "j",
    title: "Gmail's keyboard shortcuts",
    body: "j and k, e to archive, # to trash, r to reply, g i for the inbox and the rest. Archive, trash, spam, star and label changes apply at once and can be undone with z.",
  },
  {
    glyph: "¶",
    title: "Conversations as plain text",
    body: "HTML mail is converted to text, links show where they really go, remote images are never loaded, and you can select and copy any part of a message.",
  },
  {
    glyph: "↩",
    title: "Compose, reply and forward",
    body: "Reply, reply all and forward in their own windows, with attachments up to 25 MB and the original attachments carried along when forwarding.",
  },
  {
    glyph: "/",
    title: "Search and labels",
    body: "Gmail's own search syntax, sent to Gmail as you typed it, and a label picker on l for your own labels.",
  },
  {
    glyph: "↓",
    title: "Attachments",
    body: "Save attachments to your download directory with one click.",
  },
  {
    glyph: "!",
    title: "New-mail notifications",
    body: "For unread mail that lands in the inbox, skipping Gmail's Promotions, Social, Updates and Forums categories.",
  },
  {
    glyph: "✉",
    title: "Mail handler",
    body: "Eloquawk registers for mailto: links and hands them to the running window.",
  },
  {
    glyph: "⚿",
    title: "Local credentials",
    body: "Refresh tokens stay in your system keyring. Mail stays in memory and is never written to disk. No analytics or telemetry.",
  },
];

const keys = [
  [["j"], ["k"], "Next and previous conversation"],
  [["o"], ["u"], "Open a conversation, and back to the list"],
  [["e"], ["#"], "Archive, and trash"],
  [["r"], ["a"], "Reply, and reply all"],
  [["f"], ["c"], "Forward, and compose"],
  [["l"], ["/"], "Labels, and search"],
  [["g", "i"], ["g", "n"], "Go to the inbox, and to the next account"],
  [["z"], null, "Undo"],
  [["?"], null, "Every shortcut"],
] as const;

const needs = [
  "A Wayland or X11 session and working Vulkan support for GPUI rendering.",
  "An unlocked Secret Service keyring for Google sign-in, such as GNOME Keyring, KWallet or KeePassXC with its Secret Service integration enabled.",
  "A notification daemon, if you want new-mail notifications.",
  "An XDG desktop portal with a file chooser, to attach files to a message.",
];

const install = `# Launch without adding it to your profile
nix run github:korora-tech/eloquawk

# Install, then launch from your terminal or desktop application menu
nix profile add github:korora-tech/eloquawk
eloquawk`;

const homeManager = `# flake.nix
inputs.eloquawk.url = "github:korora-tech/eloquawk";

# A Home Manager module, with eloquawk passed in extraSpecialArgs
{ eloquawk, ... }:
{
  imports = [ eloquawk.homeModules.default ];
  programs.eloquawk.enable = true;
}`;
---

<Base>
  <section class="hero wrap">
    <p class="eyebrow">A native Gmail client for Linux</p>
    <h1>Your Gmail, in a fast, keyboard-driven window</h1>
    <p class="lede">
      Eloquawk is built with Rust and GPUI. Read, triage and answer mail from several Google
      accounts in one window, with Gmail's own shortcuts and desktop notifications for new mail.
    </p>
    <div class="cta">
      <CopyCommand command={SITE.demo} />
      <a class="button" href="/docs">Read the docs</a>
    </div>
    <p class="note">
      <strong>Gmail sign-in is limited to approved testers</strong> while Eloquawk's Google project
      is in Testing. <a href={testerAccess}>Ask for tester access</a> or
      <a href={ownClient}>bring your own OAuth client</a>. Demo mode works for everyone, without
      Google sign-in.
    </p>
  </section>

  <section class="shot wrap" aria-labelledby="shot-title">
    <h2 id="shot-title" class="visually-hidden">Screenshots</h2>
    <figure class="main">
      <img
        src="/screenshots/demo-inbox.webp"
        width={shot.width}
        height={shot.height}
        fetchpriority="high"
        alt="Eloquawk in the dark theme: two accounts and their labels in the sidebar, the inbox list, and the conversation Café plans open in the reading pane."
      />
      <figcaption>A real app capture using the generated demo mailbox.</figcaption>
    </figure>
    <div class="gallery">
      {
        gallery.map(({ src, alt, caption }) => (
          <figure>
            <a href={src}>
              <img src={src} width={shot.width} height={shot.height} loading="lazy" decoding="async" alt={alt} />
            </a>
            <figcaption>{caption}</figcaption>
          </figure>
        ))
      }
    </div>
  </section>

  <section id="features" class="wrap section">
    <p class="eyebrow">What it does</p>
    <h2>Read, triage and answer, without leaving the keyboard</h2>
    <div class="features">
      {
        features.map(({ glyph, title, body }) => (
          <article>
            <span class="glyph" aria-hidden="true">
              {glyph}
            </span>
            <h3>{title}</h3>
            <p>{body}</p>
          </article>
        ))
      }
    </div>
    <p class="muted narrow limits">
      <strong>Current limits:</strong> Eloquawk does not render HTML mail, edit or sync drafts
      (Drafts are listed read-only), use send-as aliases or signatures, snooze, schedule sends,
      manage filters or labels, or delete permanently. There is no offline cache, so mail is fetched
      again at startup, and no tray icon: closing the last window quits.
    </p>
  </section>

  <section class="wrap section split">
    <div>
      <p class="eyebrow">Keyboard first</p>
      <h2>The shortcuts you already know</h2>
      <p class="muted">
        Eloquawk uses Gmail's keys, and <kbd>?</kbd> shows them all. Mail keys do nothing while a
        text field has focus. Changes apply at once and <kbd>z</kbd> undoes them.
        <a href="/docs#keyboard-shortcuts">Every shortcut</a>
      </p>
    </div>
    <dl class="keys">
      {
        keys.map(([first, second, what]) => (
          <div>
            <dt>
              {first.map((k) => (
                <kbd>{k}</kbd>
              ))}
              {second && <span class="sep">/</span>}
              {second?.map((k) => (
                <kbd>{k}</kbd>
              ))}
            </dt>
            <dd>{what}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section id="checks" class="wrap section">
    <p class="eyebrow">Optional, off by default</p>
    <h2>Message checks</h2>
    <div class="split checks">
      <p class="muted">
        With your own <a href="https://openrouter.ai">OpenRouter</a> key, Eloquawk can ask Jev,
        TypeSafe's decision model, whether a message looks like phishing, a scam or spam, and
        suggest which of your labels it belongs under; <kbd>1</kbd>, <kbd>2</kbd> and <kbd>3</kbd>
        apply them. It stays off until you save a key in Settings and turn it on for an account,
        after a disclosure of exactly what is sent. Results are advisory: a banner, a list badge and
        suggested labels, never an automatic move or label.
      </p>
      <ul class="muted">
        <li>
          Only a redacted extract of the one message you open is sent. Links are cut to their
          website name, your and the recipients' addresses and recognised one-time codes are replaced, and attachments, the
          recipient list and the rest of the thread are never sent.
        </li>
        <li>Requests ask for zero data retention, and a per-session spend limit (default $1.00) stops them.</li>
        <li>Demo mode uses an offline checker and sends nothing.</li>
      </ul>
    </div>
  </section>

  <section id="install" class="wrap section">
    <p class="eyebrow">Install</p>
    <h2>One flake for Linux</h2>
    <p class="muted narrow">
      Nix packages are provided for <code>x86_64-linux</code> and <code>aarch64-linux</code>.
    </p>
    <div class="steps">
      <article>
        <h3><span>1</span> Try the demo</h3>
        <p class="muted">On a Linux desktop with Nix and flakes enabled:</p>
        <CopyCommand command={SITE.demo} />
        <p class="muted">
          Demo mode generates two accounts with about 160 conversations between them. It does not
          connect to Google, touch your keyring, send mail, save files or save preferences, and a new
          message arrives about 20 seconds after it starts so you can see a notification.
        </p>
      </article>
      <article>
        <h3><span>2</span> Install it</h3>
        <Code code={install} lang="sh" themes={themes} defaultColor={false} />
        <p class="muted small">
          On older Nix versions, use <code>nix profile install</code> in place of
          <code>nix profile add</code>.
        </p>
      </article>
      <article class="wide">
        <h3><span>3</span> Connect your Gmail</h3>
        <div class="pair">
          <div>
            <ol class="muted">
              <li>
                <a href={testerAccess}>Request tester access</a> for the Google account you intend to
                use, or <a href={ownClient}>use your own OAuth client</a>.
              </li>
              <li>Open Eloquawk, choose <strong>Sign in with Google</strong> and approve access in your browser.</li>
              <li>To connect another account, open <strong>Settings</strong> (<kbd>ctrl</kbd><kbd>,</kbd>) and choose <strong>Add account</strong>.</li>
            </ol>
            <p class="file">Your desktop needs</p>
            <ul class="muted small">
              {needs.map((n) => <li>{n}</li>)}
            </ul>
          </div>
          <div>
            <p class="file">Home Manager</p>
            <Code code={homeManager} lang="nix" themes={themes} defaultColor={false} />
            <p class="muted small">
              The module installs the package, which brings the desktop entry, the
              <code>mailto:</code> registration and the icons.{" "}
              <a href={`${SITE.repo}/blob/main/docs/desktop-integration.md#home-manager`}>Desktop integration</a>
            </p>
          </div>
        </div>
      </article>
    </div>
  </section>
</Base>

<style>
  .hero {
    padding-top: clamp(48px, 10vw, 112px);
    text-align: center;
  }

  h1 {
    margin: 0 auto;
    max-width: 18ch;
    font-size: clamp(2.3rem, 7vw, 4.4rem);
    font-weight: 700;
    letter-spacing: -0.035em;
  }

  .lede {
    max-width: 60ch;
    margin: 24px auto 0;
    color: var(--fg-muted);
    font-size: clamp(1rem, 2.2vw, 1.15rem);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 36px;
  }

  .cta > :global(.copy) {
    width: min(100%, 480px);
  }

  .button {
    display: inline-flex;
    align-items: center;
    padding: 0 20px;
    min-height: 48px;
    border: 1px solid var(--border-strong);
    border-radius: 12px;
    font-weight: 600;
    font-size: 0.92rem;
    text-decoration: none;
  }

  .button:hover {
    border-color: var(--fg-faint);
  }

  .note {
    max-width: 64ch;
    margin: 28px auto 0;
    color: var(--fg-faint);
    font-size: 0.88rem;
  }

  .note strong {
    color: var(--fg-muted);
  }

  .shot {
    margin-top: clamp(48px, 8vw, 80px);
  }

  figure {
    margin: 0;
  }

  figure img {
    width: 100%;
    height: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-sunken);
  }

  .main img {
    box-shadow: var(--shadow);
  }

  figcaption {
    margin-top: 12px;
    color: var(--fg-faint);
    font-size: 0.88rem;
    text-align: center;
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 28px 20px;
    margin-top: 40px;
  }

  .gallery a {
    display: block;
    border-radius: var(--radius);
  }

  .gallery a:hover img {
    border-color: var(--border-strong);
  }

  .section {
    margin-top: clamp(80px, 12vw, 144px);
  }

  h2 {
    margin: 0;
    max-width: 22ch;
    font-size: clamp(1.7rem, 4.4vw, 2.6rem);
    font-weight: 680;
  }

  .muted {
    color: var(--fg-muted);
  }

  .narrow {
    max-width: 64ch;
  }

  .small {
    font-size: 0.86rem;
  }

  .features {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 1px;
    margin-top: 40px;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--border);
  }

  .features article {
    padding: 28px;
    background: var(--bg-raised);
  }

  .glyph {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 9px;
    background: var(--select);
    color: var(--accent);
    font-family: var(--font-mono);
    font-weight: 600;
  }

  .features h3 {
    margin: 18px 0 8px;
    font-size: 1.08rem;
  }

  .features p {
    margin: 0;
    color: var(--fg-muted);
    font-size: 0.93rem;
  }

  .limits {
    margin-top: 24px;
    font-size: 0.9rem;
  }

  .split {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: 40px 64px;
    align-items: start;
  }

  .split .muted {
    margin-top: 20px;
  }

  .checks {
    gap: 0 64px;
  }

  .checks ul {
    margin-bottom: 0;
    padding-left: 20px;
  }

  .checks li + li {
    margin-top: 10px;
  }

  .keys {
    margin: 0;
    border-top: 1px solid var(--border);
  }

  .keys div {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid var(--border);
  }

  .keys dt {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px;
  }

  .sep {
    color: var(--fg-faint);
    font-size: 0.8rem;
  }

  .keys dd {
    margin: 0;
    color: var(--fg-muted);
    font-size: 0.93rem;
  }

  .steps {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 20px;
    margin-top: 40px;
  }

  .steps article {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
    padding: 28px;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-raised);
  }

  .steps .wide {
    grid-column: 1 / -1;
  }

  .steps h3 {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-size: 1.15rem;
  }

  .steps h3 span {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--accent-strong);
    color: var(--accent-ink);
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }

  .steps p {
    margin: 0;
  }

  .steps ol,
  .steps ul {
    margin: 0;
    padding-left: 20px;
  }

  .steps li + li {
    margin-top: 8px;
  }

  .steps :global(pre) {
    background: var(--bg-sunken);
  }

  .pair {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: 20px 32px;
  }

  .pair > div {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }

  .file {
    margin-top: 8px;
    color: var(--fg-faint);
    font-family: var(--font-mono);
    font-size: 0.78rem;
  }
</style>
